  <name>Signature PDF</name>
  <summary>Sign, organize, edit the metadata of and compress PDFs</summary>
  <developer id="fr._24eme">
    <name>24eme</name>
  </developer>

  <description>
    <p>
      Signature PDF is free web software for signing (alone or with others), organizing, editing metadata or compressing PDFs.
    </p>
    <ul>
      <li>Sign, initial, stamp and complete a document</li>
      <li>Share a PDF to sign it with multiple people</li>
      <li>Merge, sort, rotate, delete and extract pages</li>
      <li>Edit the metadata of a PDF</li>
      <li>Compress a PDF to reduce its file size</li>
    </ul>
  </description>

  <launchable type="url">https://pdf.24eme.fr/</launchable>
